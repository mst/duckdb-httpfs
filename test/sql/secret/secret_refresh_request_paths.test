# name: test/sql/secret/secret_refresh_request_paths.test
# description: Tests credential refresh on the glob-listing, range-GET, and write request paths (secret_refresh.test covers the file-open path).
# group: [secret]

require-env S3_TEST_SERVER_AVAILABLE 1

require-env AWS_DEFAULT_REGION

require-env AWS_ACCESS_KEY_ID

require-env AWS_SECRET_ACCESS_KEY

require-env DUCKDB_S3_ENDPOINT

require-env DUCKDB_S3_USE_SSL

set ignore_error_messages

require httpfs

require parquet

statement ok
SET enable_logging=true

statement ok
set s3_use_ssl='${DUCKDB_S3_USE_SSL}'

statement ok
set s3_endpoint='${DUCKDB_S3_ENDPOINT}'

statement ok
set s3_region='${AWS_DEFAULT_REGION}'

# Seed two parquet files under a unique prefix with a working secret.
statement ok
CREATE SECRET s1 (
    TYPE S3,
    KEY_ID '${AWS_ACCESS_KEY_ID}',
    SECRET '${AWS_SECRET_ACCESS_KEY}'
)

statement ok
COPY (SELECT range AS a FROM range(5)) TO 's3://test-bucket/secret_refresh_request_paths/data1.parquet'

statement ok
COPY (SELECT range AS a FROM range(5)) TO 's3://test-bucket/secret_refresh_request_paths/data2.parquet'

statement ok
DROP SECRET s1;set enable_logging=false;set logging_storage='stdout';set logging_storage='memory';set enable_logging=true;

# The pattern in every phase below: a secret whose initial credentials are
# wrong but whose REFRESH_INFO holds working credentials. The first request
# fails, the secret refreshes, and the retry succeeds. Refresh is asserted by
# the presence of the refresh log line (a single statement may refresh more
# than once, so assert presence rather than an exact count).

# ==================================================================
# Phase A: file-open / read path (control; also covered by secret_refresh.test).
# ==================================================================
statement ok
CREATE SECRET s1 (
    TYPE S3,
    KEY_ID 'BOGUS',
    SECRET 'ALSO BOGUS',
    REFRESH_INFO MAP {
        'KEY_ID': '${AWS_ACCESS_KEY_ID}',
        'SECRET': '${AWS_SECRET_ACCESS_KEY}'
    }
)

statement ok
FROM 's3://test-bucket/secret_refresh_request_paths/data1.parquet'

query I
SELECT any_value(message[0:46]) FROM duckdb_logs WHERE message like '%Successfully refreshed secret%'
----
Successfully refreshed secret: s1, new key_id:

statement ok
DROP SECRET s1;set enable_logging=false;set logging_storage='stdout';set logging_storage='memory';set enable_logging=true;

# ==================================================================
# Phase B: glob listing path (AWSListObjectV2). glob() only lists objects and
# never opens a file handle, so it exercises the listing refresh independently
# of the file-open path.
# ==================================================================
statement ok
CREATE SECRET s1 (
    TYPE S3,
    KEY_ID 'BOGUS',
    SECRET 'ALSO BOGUS',
    REFRESH_INFO MAP {
        'KEY_ID': '${AWS_ACCESS_KEY_ID}',
        'SECRET': '${AWS_SECRET_ACCESS_KEY}'
    }
)

query I
SELECT count(*)::BIGINT FROM glob('s3://test-bucket/secret_refresh_request_paths/*.parquet')
----
2

query I
SELECT any_value(message[0:46]) FROM duckdb_logs WHERE message like '%Successfully refreshed secret%'
----
Successfully refreshed secret: s1, new key_id:

statement ok
DROP SECRET s1;set enable_logging=false;set logging_storage='stdout';set logging_storage='memory';set enable_logging=true;

# ==================================================================
# Phase C: range-GET path. The metadata cache is keyed by URL and survives a
# secret swap, so reading once with a working secret caches the object's
# metadata; after swapping to the refreshable secret, the re-read finds that
# metadata cached, skips the HEAD, and issues the data range GET as the first
# request against the bad credentials -- exercising the range-GET refresh.
# enable_external_file_cache=false keeps the re-read from serving cached bytes.
# ==================================================================
statement ok
SET enable_http_metadata_cache=true

statement ok
SET enable_external_file_cache=false

statement ok
CREATE SECRET s1 (
    TYPE S3,
    KEY_ID '${AWS_ACCESS_KEY_ID}',
    SECRET '${AWS_SECRET_ACCESS_KEY}'
)

statement ok
FROM 's3://test-bucket/secret_refresh_request_paths/data1.parquet'

statement ok
DROP SECRET s1;set enable_logging=false;set logging_storage='stdout';set logging_storage='memory';set enable_logging=true;

statement ok
CREATE SECRET s1 (
    TYPE S3,
    KEY_ID 'BOGUS',
    SECRET 'ALSO BOGUS',
    REFRESH_INFO MAP {
        'KEY_ID': '${AWS_ACCESS_KEY_ID}',
        'SECRET': '${AWS_SECRET_ACCESS_KEY}'
    }
)

query I
SELECT count(*)::BIGINT FROM 's3://test-bucket/secret_refresh_request_paths/data1.parquet'
----
5

query I
SELECT any_value(message[0:46]) FROM duckdb_logs WHERE message like '%Successfully refreshed secret%'
----
Successfully refreshed secret: s1, new key_id:

statement ok
DROP SECRET s1;set enable_logging=false;set logging_storage='stdout';set logging_storage='memory';set enable_logging=true;

# ==================================================================
# Phase D: write (PUT/POST) path. A small single-shot COPY issues one PUT.
# Written to a prefix outside Phase B's glob so repeated runs stay idempotent.
# ==================================================================
statement ok
CREATE SECRET s1 (
    TYPE S3,
    KEY_ID 'BOGUS',
    SECRET 'ALSO BOGUS',
    REFRESH_INFO MAP {
        'KEY_ID': '${AWS_ACCESS_KEY_ID}',
        'SECRET': '${AWS_SECRET_ACCESS_KEY}'
    }
)

statement ok
COPY (SELECT range AS a FROM range(5)) TO 's3://test-bucket/secret_refresh_written/out.parquet'

query I
SELECT any_value(message[0:46]) FROM duckdb_logs WHERE message like '%Successfully refreshed secret%'
----
Successfully refreshed secret: s1, new key_id:

# Confirm the data landed.
query I
SELECT count(*)::BIGINT FROM 's3://test-bucket/secret_refresh_written/out.parquet'
----
5

statement ok
DROP SECRET s1;
